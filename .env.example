# ---- Local development --------------------------------------------------
DATABASE_URL=postgresql+psycopg://calorie:calorie@localhost:5432/calorie_tracker

# ---- Required everywhere ------------------------------------------------
# Long random string: openssl rand -hex 32
SECRET_KEY=change-me

# ---- Production (docker-compose.prod.yml) -------------------------------
# Domain pointing at the server (A record). Used for HTTPS and WEBAPP_URL.
DOMAIN=tracker.example.com
# Letters and digits only (it is embedded in a URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# ---- Telegram Mini App --------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random string Telegram sends with every webhook call: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS address of the app. Set automatically from DOMAIN in production;
# set it by hand for local testing through a tunnel (ngrok / cloudflared).
WEBAPP_URL=
